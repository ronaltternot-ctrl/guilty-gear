	sum2 = dot(s0, vec4(0.0791591108, -0.123312823, -0.152358189, 0.0281403195)) + dot(s1, vec4(-0.0750747994, -0.0408231653, 0.115973517, -0.0844086409)) + dot(s2, vec4(0.051221434, -0.0739859641, 0.0705103725, -0.0405949578)) + dot(s3, vec4(0.038871821, -0.147691637, 0.646373272, 0.0370681398)) + dot(s4, vec4(0.0887015164, -0.10674347, 0.132359281, -0.0375593975)) + dot(s5, vec4(-0.197902545, -0.143714339, 0.212204427, -0.131294057)) + dot(s6, vec4(0.0215676706, -0.137466744, 0.0419805981, -0.0196264554)) + dot(s7, vec4(-0.242089674, 0.117791414, 0.225677162, -0.152953178));
	sum1 = exp(sum1 * mstd2 + -0.751484394);
	sum2 = sum2 * mstd2 + -1.57718015;
	wsum += sum1;
	vsum += sum1 * (sum2 / (1.0 + abs(sum2)));
	sum1 = dot(s0, vec4(0.0280956291, -0.248029619, -0.093611598, 0.120763868)) + dot(s1, vec4(-0.0151967146, -0.115728229, 0.0276339911, -0.0170841776)) + dot(s2, vec4(-0.0757886469, -0.00189510337, -0.330781132, 0.144799024)) + dot(s3, vec4(-0.113528699, 0.444209129, 0.800910413, -0.0511436202)) + dot(s4, vec4(0.0306318216, -0.587477744, 0.313568145, -0.035486538)) + dot(s5, vec4(0.000257190521, -0.0768467486, 0.0293522738, 0.0157073699)) + dot(s6, vec4(0.00409575924, -0.122022927, -0.0146673061, 0.00376766571)) + dot(s7, vec4(-0.0198479109, -0.0787514448, 0.00236740359, 0.0317285322));
	sum2 = dot(s0, vec4(-0.0142145911, 0.0929911658, -0.0187178683, -0.0773005933)) + dot(s1, vec4(0.0459014885, 0.0580323674, -0.116376638, 0.0182055086)) + dot(s2, vec4(-0.0037575711, 0.105651066, 0.0135074658, -0.118066177)) + dot(s3, vec4(-0.0482615083, 0.417299956, -0.0489475876, -0.0429664701)) + dot(s4, vec4(-0.0269434359, 0.141708612, -0.124377489, 0.0178679414)) + dot(s5, vec4(0.018428782, -0.0844665691, -0.0493167341, 0.00179325661)) + dot(s6, vec4(0.00295368466, 0.006970583, -0.0599843934, 0.0212675426)) + dot(s7, vec4(-0.00787362922, -0.0451287106, -0.0212315116, -0.05464793));
	sum1 = exp(sum1 * mstd2 + -0.0804181099);
	sum2 = sum2 * mstd2 + 1.10379398;
	wsum += sum1;
	vsum += sum1 * (sum2 / (1.0 + abs(sum2)));
	sum1 = dot(s0, vec4(-0.023616977, 0.126101971, -0.0898551717, -0.0326562002)) + dot(s1, vec4(-0.00739908917, -0.00850433763, -0.0578625277, -0.00256994343)) + dot(s2, vec4(-0.00959182438, 0.313410044, -0.118259914, -0.0345895961)) + dot(s3, vec4(0.184198797, -0.231230319, -0.222840771, 0.0810522363)) + dot(s4, vec4(0.0261763409, -0.0195858981, 0.13386482, -0.00754564209)) + dot(s5, vec4(-0.0208524838, 0.0911004469, 0.0346255228, -0.0736596361)) + dot(s6, vec4(0.000236623644, -0.0304087773, 0.0147987539, 0.0146594876)) + dot(s7, vec4(-0.0343552977, 0.0688028559, 0.0544002578, -0.118043728));
	sum2 = dot(s0, vec4(-0.0630829632, 0.0276141539, 0.0106123909, -0.0178769231)) + dot(s1, vec4(-0.0290163681, 0.0199531242, 0.0175425038, -0.00639144331)) + dot(s2, vec4(-0.239463866, 0.230356246, -0.043300651, 0.026393868)) + dot(s3, vec4(-1.18540406, 1.33317864, -0.0776217207, 0.0646397099)) + dot(s4, vec4(-0.201608405, 0.19622013, -0.0160418451, 0.0180274025)) + dot(s5, vec4(-0.0358164385, 0.041806899, -0.0187533945, -0.0110477731)) + dot(s6, vec4(-0.0337778553, 0.0194017962, 0.000338755432, -0.0112909302)) + dot(s7, vec4(-0.0219679549, 0.0110991523, 0.00669059902, -0.0114128813));
	sum1 = exp(sum1 * mstd2 + 0.713412762);
	sum2 = sum2 * mstd2 + -0.026578242;
	wsum += sum1;
	vsum += sum1 * (sum2 / (1.0 + abs(sum2)));
	sum1 = dot(s0, vec4(0.068695724, -0.0879503489, 0.199498564, -0.0295044221)) + dot(s1, vec4(0.106151938, -0.0225349106, 0.0661278963, 0.0539669953)) + dot(s2, vec4(0.179371953, -0.518707156, 0.391991317, -0.119169176)) + dot(s3, vec4(0.104595006, 0.250575364, -0.376388341, 0.14741832)) + dot(s4, vec4(0.000667018059, 0.540946186, -0.968569458, 0.162418798)) + dot(s5, vec4(0.0627593696, 0.0877500772, -0.452053666, 0.124483973)) + dot(s6, vec4(0.0620412789, 0.0849098861, -0.162766933, 0.0721010864)) + dot(s7, vec4(0.0382235534, 0.173159033, -0.32348758, 0.0832787156));
	sum2 = dot(s0, vec4(-0.0326454416, 0.0794639662, 0.00388407125, -0.0777713284)) + dot(s1, vec4(-0.0269809868, 0.0445911065, -0.0509688407, -0.000849670032)) + dot(s2, vec4(-0.0124094393, 0.0235069934, 0.0317461714, -0.0715580136)) + dot(s3, vec4(-0.0402715728, 0.235049486, 0.112278037, -0.00562617742)) + dot(s4, vec4(-0.0515453145, 0.0871569291, -0.0700045153, 0.00263428106)) + dot(s5, vec4(-0.0386480466, -0.0617472902, 0.0125172231, -0.00892602466)) + dot(s6, vec4(-0.00452606939, 0.018785486, -0.0162808802, -0.00688389502)) + dot(s7, vec4(-0.0141501483, -0.0574722588, -0.0113450792, 0.00899722613));
	sum1 = exp(sum1 * mstd2 + -0.894535542);
	sum2 = sum2 * mstd2 + -0.151376694;
	wsum += sum1;
	vsum += sum1 * (sum2 / (1.0 + abs(sum2)));
	sum1 = dot(s0, vec4(0.0422296934, -0.0473749824, -0.057317961, -0.0943710953)) + dot(s1, vec4(-0.0088665653, -0.0281822253, -0.142781749, -0.00316860783)) + dot(s2, vec4(0.184607491, -0.447350055, 0.25426206, -0.126287058)) + dot(s3, vec4(-0.150676563, 0.826232612, 0.37696448, -0.125051811)) + dot(s4, vec4(-0.166275561, 0.589147627, -0.547771752, -0.036891643)) + dot(s5, vec4(-0.0481759794, 0.0289029907, -0.0349304862, -0.0473961718)) + dot(s6, vec4(-0.0280929971, 0.0741818696, -0.0749799162, -0.0494190939)) + dot(s7, vec4(-0.0153320078, 0.0106980931, -0.0854005367, -0.0211320687));
	sum2 = dot(s0, vec4(-0.098842755, 0.0378162563, 0.0755017474, -0.0322060734)) + dot(s1, vec4(-0.0213285089, -0.0574694574, 0.00456310902, -0.00596742984)) + dot(s2, vec4(-0.150088325, 0.0896545276, 0.11872866, -0.0436399281)) + dot(s3, vec4(-0.0329397172, -0.0128631955, 0.382465184, -0.078786388)) + dot(s4, vec4(-0.0178594887, -0.0973252952, 0.239088595, -0.0802550465)) + dot(s5, vec4(0.0184333697, -0.0614915192, -0.0124637177, -0.00513269659)) + dot(s6, vec4(-0.0212454945, -0.0563845187, 0.0301498473, -0.0475758761)) + dot(s7, vec4(-0.0121067232, -0.0417661816, 0.00386038516, -0.0125233447));
	sum1 = exp(sum1 * mstd2 + -0.12337923);
	sum2 = sum2 * mstd2 + 0.958881021;
	wsum += sum1;
	vsum += sum1 * (sum2 / (1.0 + abs(sum2)));
	sum1 = dot(s0, vec4(0.0590119027, -0.078537792, 0.0668227077, -0.0349844433)) + dot(s1, vec4(-0.00154671422, 0.0277120732, -0.0246969201, 0.0107344873)) + dot(s2, vec4(0.125855833, -0.4671565, 0.344141394, -0.122863919)) + dot(s3, vec4(-0.169647127, 0.215524763, 0.0850286633, -0.113646418)) + dot(s4, vec4(-0.189910576, 0.434953213, -0.352054507, -0.0291969962)) + dot(s5, vec4(-0.0131890811, 0.0231622718, 0.0636178553, 0.03899258)) + dot(s6, vec4(-0.0127589442, 0.100814581, -0.000570986245, -0.0275189914)) + dot(s7, vec4(0.0126841851, -0.0225861706, -0.0451703407, 0.0969799459));
	sum2 = dot(s0, vec4(-0.0130693028, -0.0079038078, 0.0300712865, 0.000595702673)) + dot(s1, vec4(-0.00947474036, -0.0338317454, 0.0278430339, -0.0148665467)) + dot(s2, vec4(0.0417562574, 0.00181819394, -0.0378746986, 0.0546407662)) + dot(s3, vec4(0.0405909047, -0.432419926, -0.773078859, -0.00844693277)) + dot(s4, vec4(0.0448104441, 0.292329401, 0.0682754591, -0.0129543254)) + dot(s5, vec4(0.0145336902, 0.548888803, -0.0201215614, -0.0297403652)) + dot(s6, vec4(0.0175909307, 0.0775763467, 0.0680611432, 0.0121016642)) + dot(s7, vec4(-0.0242541302, 0.0824093521, -0.0113106975, 0.00545426365));
	sum1 = exp(sum1 * mstd2 + 0.616443157);
	sum2 = sum2 * mstd2 + -0.042390395;
	wsum += sum1;
	vsum += sum1 * (sum2 / (1.0 + abs(sum2)));
	return clamp(mstd0 + 5.0 * vsum / wsum * mstd1, 0.0, 1.0);
}

void WindowLuma(vec2 sp, out vec4 s0, out vec4 s1, out vec4 s2, out vec4 s3, out vec4 s4, out vec4 s5, out vec4 s6, out vec4 s7) {
	vec3 t_m3_m1 = Src(sp + vec2(-3.0, -1.0));
	vec3 t_m3_0 = Src(sp + vec2(-3.0, 0.0));
	vec3 t_m3_1 = Src(sp + vec2(-3.0, 1.0));
	vec3 t_m3_2 = Src(sp + vec2(-3.0, 2.0));
	vec3 t_m2_m1 = Src(sp + vec2(-2.0, -1.0));
	vec3 t_m2_0 = Src(sp + vec2(-2.0, 0.0));
	vec3 t_m2_1 = Src(sp + vec2(-2.0, 1.0));
	vec3 t_m2_2 = Src(sp + vec2(-2.0, 2.0));
	vec3 t_m1_m1 = Src(sp + vec2(-1.0, -1.0));
	vec3 t_m1_0 = Src(sp + vec2(-1.0, 0.0));
	vec3 t_m1_1 = Src(sp + vec2(-1.0, 1.0));
	vec3 t_m1_2 = Src(sp + vec2(-1.0, 2.0));
	vec3 t_0_m1 = Src(sp + vec2(0.0, -1.0));
	vec3 t_0_0 = Src(sp + vec2(0.0, 0.0));
	vec3 t_0_1 = Src(sp + vec2(0.0, 1.0));
	vec3 t_0_2 = Src(sp + vec2(0.0, 2.0));
	vec3 t_1_m1 = Src(sp + vec2(1.0, -1.0));
	vec3 t_1_0 = Src(sp + vec2(1.0, 0.0));
	vec3 t_1_1 = Src(sp + vec2(1.0, 1.0));
	vec3 t_1_2 = Src(sp + vec2(1.0, 2.0));
	vec3 t_2_m1 = Src(sp + vec2(2.0, -1.0));
	vec3 t_2_0 = Src(sp + vec2(2.0, 0.0));
	vec3 t_2_1 = Src(sp + vec2(2.0, 1.0));
	vec3 t_2_2 = Src(sp + vec2(2.0, 2.0));
	vec3 t_3_m1 = Src(sp + vec2(3.0, -1.0));
	vec3 t_3_0 = Src(sp + vec2(3.0, 0.0));
	vec3 t_3_1 = Src(sp + vec2(3.0, 1.0));
	vec3 t_3_2 = Src(sp + vec2(3.0, 2.0));
	vec3 t_4_m1 = Src(sp + vec2(4.0, -1.0));
	vec3 t_4_0 = Src(sp + vec2(4.0, 0.0));
	vec3 t_4_1 = Src(sp + vec2(4.0, 1.0));
	vec3 t_4_2 = Src(sp + vec2(4.0, 2.0));
	s0 = vec4(dot(t_m3_m1, LUMA), dot(t_m3_0, LUMA), dot(t_m3_1, LUMA), dot(t_m3_2, LUMA));
	s1 = vec4(dot(t_m2_m1, LUMA), dot(t_m2_0, LUMA), dot(t_m2_1, LUMA), dot(t_m2_2, LUMA));
	s2 = vec4(dot(t_m1_m1, LUMA), dot(t_m1_0, LUMA), dot(t_m1_1, LUMA), dot(t_m1_2, LUMA));
	s3 = vec4(dot(t_0_m1, LUMA), dot(t_0_0, LUMA), dot(t_0_1, LUMA), dot(t_0_2, LUMA));
	s4 = vec4(dot(t_1_m1, LUMA), dot(t_1_0, LUMA), dot(t_1_1, LUMA), dot(t_1_2, LUMA));
	s5 = vec4(dot(t_2_m1, LUMA), dot(t_2_0, LUMA), dot(t_2_1, LUMA), dot(t_2_2, LUMA));
	s6 = vec4(dot(t_3_m1, LUMA), dot(t_3_0, LUMA), dot(t_3_1, LUMA), dot(t_3_2, LUMA));
	s7 = vec4(dot(t_4_m1, LUMA), dot(t_4_0, LUMA), dot(t_4_1, LUMA), dot(t_4_2, LUMA));
}

void main() {
	vec2 p = v_texcoord0 / u_texelDelta;   // position in source pixels
	vec2 sp = floor(p);                      // source pixel
	vec2 half2 = floor(fract(p) * 2.0);      // which of the 2x2 output pixels this is
	if (half2.x > 0.5) {
		// Odd columns are never read by the horizontal pass.
		gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);
		return;
	}
	vec3 here = Src(sp);
	if (half2.y < 0.5) {
		gl_FragColor = vec4(here, 1.0);   // Original row.
		return;
	}
	// New row between source rows sp.y and sp.y + 1.
	vec4 s0, s1, s2, s3, s4, s5, s6, s7;
	WindowLuma(sp, s0, s1, s2, s3, s4, s5, s6, s7);
	float predicted = Nnedi3V(s0, s1, s2, s3, s4, s5, s6, s7);
	// Color from Catmull-Rom halfway between the two neighbours, matched to the
	// brightness the network predicted.
	vec3 a = Src(sp - vec2(0.0, 1.0));
	vec3 b = here;
	vec3 c = Src(sp + vec2(0.0, 1.0));
	vec3 d = Src(sp + 2.0 * vec2(0.0, 1.0));
	vec3 cubic = (-a + 9.0 * b + 9.0 * c - d) * (1.0 / 16.0);
	// Keep the cubic estimate inside the neighbours' range to avoid halos.
	cubic = clamp(cubic, min(b, c), max(b, c));
	vec3 color = cubic + (predicted - dot(cubic, LUMA));
	gl_FragColor = vec4(clamp(color, 0.0, 1.0), 1.0);
}
