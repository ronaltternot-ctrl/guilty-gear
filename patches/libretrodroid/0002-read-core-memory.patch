+bool LibretroDroid::readMemory(unsigned id, size_t offset, int8_t *out, size_t size) {
+    // Between two frames (the core runs with this lock held): the values belong to one frame.
+    std::lock_guard<std::mutex> lock(coreLock);
+
+    if (core == nullptr) {
+        return false;
+    }
+    size_t total = core->retro_get_memory_size(id);
+    auto *data = (int8_t *) core->retro_get_memory_data(id);
+    if (data == nullptr || offset > total || size > total - offset) {
+        return false;
+    }
+    memcpy(out, data + offset, size);
+    return true;
+}
