+// GBS++: org.ppsspp.ppsspp.RetroMemory.read(id, offset, out): fills out with the core's memory
+// from offset (RETRO_MEMORY_SYSTEM_RAM is 2). False when the core has no such memory (or no core).
+JNIEXPORT jboolean JNICALL Java_org_ppsspp_ppsspp_RetroMemory_read(
+    JNIEnv* env,
+    jclass obj,
+    jint id,
+    jint offset,
+    jbyteArray out
+) {
+    if (out == nullptr || id < 0 || offset < 0) {
+        return JNI_FALSE;
+    }
+    jsize size = env->GetArrayLength(out);
+    jbyte *buffer = env->GetByteArrayElements(out, nullptr);
+    if (buffer == nullptr) {
+        return JNI_FALSE;
+    }
+    bool ok = LibretroDroid::getInstance().readMemory((unsigned) id, (size_t) offset, (int8_t *) buffer, (size_t) size);
+    env->ReleaseByteArrayElements(out, buffer, ok ? 0 : JNI_ABORT);
+    return ok ? JNI_TRUE : JNI_FALSE;
+}
