+
+/*
+ * GGXX AC+ launcher build: the passes of a SHADER_CUSTOM chain, from the params map:
+ *   PASSES          number of passes (1 to 8)
+ *   LINEAR          "1": the game's frame is sampled with linear filtering
+ *   P<i>_VERTEX     vertex shader of pass i (GLSL ES 1.00)
+ *   P<i>_FRAGMENT   fragment shader of pass i
+ *   P<i>_SCALE      size of pass i's output, times the game's frame (the last pass draws to the screen)
+ *   P<i>_LINEAR     "1": the next pass samples pass i's output with linear filtering
+ */
+ShaderManager::Chain ShaderManager::customChain(const std::unordered_map<std::string, std::string>& params) {
+    auto get = [&params](const std::string& key, const std::string& fallback) {
+        auto it = params.find(key);
+        return it == params.end() ? fallback : it->second;
+    };
+    Chain chain { {}, get("LINEAR", "0") == "1" };
+    int passes = std::atoi(get("PASSES", "0").c_str());
+    for (int i = 0; i < passes && i < 8; i++) {
+        std::string prefix = "P" + std::to_string(i) + "_";
+        std::string vertex = get(prefix + "VERTEX", "");
+        std::string fragment = get(prefix + "FRAGMENT", "");
+        float scale = (float) std::atof(get(prefix + "SCALE", "1").c_str());
+        if (vertex.empty() || fragment.empty() || !(scale > 0.0f && scale <= 16.0f)) {
+            return { {}, false };
+        }
+        chain.passes.push_back({ vertex, fragment, get(prefix + "LINEAR", "0") == "1", scale });
+    }
+    return chain;
 }
 
