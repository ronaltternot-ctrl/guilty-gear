+// Launcher build (GGXX AC+): just the on-screen button layout, for per-character profiles.
+// That is the whole [TouchControls.Landscape] block plus the custom button definitions.
+static bool IsTouchLayoutControlKey(std::string_view key) {
+	return startsWith(key, "Custom");
+}
+
+void Config::SaveTouchLayout(IniFile &ini) const {
+	Section *control = ini.GetOrCreateSection("Control");
+	for (const ConfigSetting &setting : controlSettings) {
+		if (IsTouchLayoutControlKey(setting.IniKey()))
+			setting.WriteToIniSection(this, control);
+	}
+	Section *touch = ini.GetOrCreateSection("TouchControls.Landscape");
+	for (const ConfigSetting &setting : touchControlSettings) {
+		setting.WriteToIniSection(&touchControlsLandscape, touch);
+	}
+}
+
+void Config::LoadTouchLayout(const IniFile &ini, bool resetFirst) {
+	if (resetFirst) {
+		// Back to defaults first, so keys missing from a partial layout don't keep old values.
+		for (const ConfigSetting &setting : controlSettings) {
+			if (IsTouchLayoutControlKey(setting.IniKey()))
+				setting.RestoreToDefault(this, false);
+		}
+		for (const ConfigSetting &setting : touchControlSettings) {
+			setting.RestoreToDefault(&touchControlsLandscape, false);
+		}
+	}
+	if (const Section *control = ini.GetSection("Control")) {
+		for (const ConfigSetting &setting : controlSettings) {
+			if (IsTouchLayoutControlKey(setting.IniKey()))
+				setting.ReadFromIniSection(this, control, false);
+		}
+	}
+	if (const Section *touch = ini.GetSection("TouchControls.Landscape")) {
+		for (const ConfigSetting &setting : touchControlSettings) {
+			setting.ReadFromIniSection(&touchControlsLandscape, touch, false);
+		}
+	}
+}
